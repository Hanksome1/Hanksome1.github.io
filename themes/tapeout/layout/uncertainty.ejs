        <tr><td>c = e^(iα)</td><td>ΔxΔp = ħ / (2 sin α)</td><td>α = 30°：1.00 ħ；90°：0.50 ħ</td></tr>
        <tr><td>sech / 三角形 / 雙峰</td><td>數值積分（格距 0.002）</td><td>0.524 / 0.548 / 2.10 ħ</td></tr>
        <tr><td>振子 |1⟩ / |2⟩</td><td>(n + ½)ħ</td><td>1.5 / 2.5 ħ</td></tr>
