<%
  // 筆記：source/_posts/notes/ 的文章，加上 front-matter 寫了 kind: note 的獨立頁面（例如 source/lab/ 的互動式頁面）
  var notes = split_posts(site.posts).notes
    .concat(site.pages.filter(function (p) { return p.kind === 'note'; }).toArray())
    .sort(function (a, b) { return b.updated - a.updated; });
  var g = graph_data();
  var courses = note_courses();
  var sec = 1;
%>
<section class="page-head wrap" data-section="NOTES">
  <p class="kicker">§03 — Netlist</p>
  <h1 class="page-title"><%= page.title || 'Notes' %><sup><%= notes.length %></sup></h1>
  <% if (page.content) { %><div class="page-lede"><%- page.content %></div><% } %>
</section>

<% if (courses.length) { %>
<section class="section section-tight wrap" data-section="COURSES">
  <header class="section-head">
    <p class="kicker">§03.<%= sec++ %> — Courses</p>
    <h2 class="section-title">Courses</h2>
  </header>
  <div class="chip-grid course-grid">
    <% courses.forEach(function (c, i) { %>
      <article class="chip-card course-card reveal">
        <span class="chip-designator" aria-hidden="true">J<%= i + 1 %></span>
        <%# 有動畫導覽（notes.courses 的 tour）的課程，卡片先進動畫，動畫裡再連到總覽 %>
        <a class="chip-link" href="<%- url_for(c.tour || c.hub.path) %>">
          <div class="chip-body">
            <div class="chip-meta"><span><%= [c.code || c.tag, c.term].filter(Boolean).join(' · ') %></span></div>
            <h3 class="chip-title"><%= c.name || c.hub.title %></h3>
            <% if (c.hub.summary || c.summary) { %><p class="chip-summary"><%= c.hub.summary || c.summary %></p><% } %>
            <dl class="chip-metrics">
              <div><dt><%= c.hub.chapters ? 'Chapters' : 'Notes' %></dt><dd><%= c.notes.length %></dd></div>
              <div><dt>Reading</dt><dd><%= c.minutes %> min</dd></div>
              <div><dt>Tended</dt><dd><time datetime="<%= date_xml(c.updated) %>"><%= date(c.updated, 'YYYY.MM.DD') %></time></dd></div>
            </dl>
            <% if (c.topics.length) { %>
              <ul class="chip-stack"><% c.topics.forEach(function (t) { %><li><%= t %></li><% }) %></ul>
            <% } %>
          </div>
          <span class="chip-arrow" aria-hidden="true">→</span>
        </a>
      </article>
    <% }) %>
  </div>
</section>
<% } %>

<section class="section section-tight wrap" data-section="GRAPH">
  <%- partial('_partial/graph', { graph: g, variant: 'global', file: 'netlist.graph', height: 'min(72vh, 640px)' }) %>
</section>

<section class="section wrap" data-section="INDEX">
  <header class="section-head">
    <p class="kicker">§03.<%= sec++ %> — Index</p>
    <h2 class="section-title">Recently tended</h2>
  </header>
  <% if (notes.length) { %>
    <div class="log-list">
      <% notes.forEach(function (post) { %><%- partial('_partial/post-row', { post: post, useUpdated: true }) %><% }) %>
    </div>
  <% } else { %>
    <p class="empty">還沒有筆記。用 Obsidian 打開 <code>source/</code> 資料夾，新筆記會自動存到 <code>source/_posts/notes/</code>。</p>
  <% } %>
</section>
