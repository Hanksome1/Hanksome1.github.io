<%
  // 論文頁的導覽，chapter 來自 course_paper()。at: 'top' 是頁首那一條，'bottom' 是頁尾的較新、較舊。
  // 論文依發表時間由新到舊排，沒有固定的閱讀順序，所以不寫「第幾章」。
  var c = chapter;
  var ym = function (d) { return String(d || '').replace('-', '.'); };
%>
<% if (at === 'top') { %>
<nav class="cc-bar wrap" aria-label="所屬的論文清單">
  <a href="<%- url_for(c.hubUrl) %>"><%= c.name %></a>
  <span class="cc-where"><%= ym(c.chapters[c.index].date) %> · 共 <%= c.total %> 篇<% if (c.isAlt) { %> · <%= c.altLabel %><% } %></span>
  <span class="cc-dots" aria-hidden="true"><% c.chapters.forEach(function (ch, i) { %><i<% if (i === c.index) { %> class="is-on"<% } %>></i><% }) %></span>
</nav>
<% } else { %>
<nav class="cc-foot wrap" aria-label="其他論文">
  <% if (c.prev) { %>
    <a class="cc-link" href="<%- url_for(c.prev.url) %>"><span class="cc-label">← 較新 · <%= ym(c.prev.date) %></span><span class="cc-title"><%= c.prev.paper %></span></a>
  <% } else { %>
    <a class="cc-link" href="<%- url_for(c.hubUrl) %>"><span class="cc-label">← 論文清單</span><span class="cc-title"><%= c.name %></span></a>
  <% } %>
  <% if (c.next) { %>
    <a class="cc-link cc-next" href="<%- url_for(c.next.url) %>"><span class="cc-label">較舊 · <%= ym(c.next.date) %> →</span><span class="cc-title"><%= c.next.paper %></span></a>
  <% } else { %>
    <a class="cc-link cc-next" href="<%- url_for(c.hubUrl) %>"><span class="cc-label">論文清單 →</span><span class="cc-title"><%= c.name %></span></a>
  <% } %>
</nav>
<% } %>
