<%
  // 參數：graph（graph_data() 的回傳值）、variant（global | local）、file、height、tagsOn（Tags 預設開啟）
  var isGlobal = variant === 'global';
  var tagsChecked = typeof tagsOn !== 'undefined' && tagsOn;
%>
<figure class="wave netlist netlist-<%= variant %>" data-graph data-variant="<%= variant %>">
  <figcaption class="wave-bar">
    <span class="wave-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="wave-file"><%= file %></span>
    <span class="netlist-legend" aria-hidden="true">
      <span><i class="lg lg-project"></i>Project</span>
      <span><i class="lg lg-post"></i>Writing</span>
      <span><i class="lg lg-note"></i>Note</span>
      <span><i class="lg lg-ghost"></i>Unwritten</span>
    </span>
    <span class="wave-spec"><%= graph.nodes %> nodes · <%= graph.links %> nets</span>
  </figcaption>
  <div class="netlist-stage" style="height: <%= height %>">
    <canvas role="img" aria-label="<%= __(isGlobal ? 'graph.global' : 'graph.local', graph.nodes) %>"></canvas>
    <div class="netlist-tools">
      <% if (isGlobal) { %>
        <input type="search" class="nl-search" placeholder="Find node…" aria-label="<%= __('graph.search') %>" enterkeyhint="search" data-graph-search>
      <% } %>
      <button type="button" class="nl-gear" data-graph-gear aria-expanded="false" aria-label="<%= __('graph.settings') %>">
        <svg class="nl-i" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12M5 2.5v3M10.5 6.5v3M7 10.5v3"/></svg>
      </button>
      <span class="nl-zoom">
        <button type="button" data-graph-zoom="1.3" aria-label="<%= __('graph.zoom_in') %>">+</button>
        <button type="button" data-graph-zoom="0.77" aria-label="<%= __('graph.zoom_out') %>">−</button>
        <button type="button" data-graph-fit>Fit</button>
      </span>
      <button type="button" class="nl-expand" data-graph-expand aria-expanded="false" aria-label="<%= __('graph.expand') %>" data-label-open="<%= __('graph.expand') %>" data-label-close="<%= __('graph.collapse') %>">
        <svg class="nl-i nl-i-expand" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4"/></svg>
        <svg class="nl-i nl-i-close" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg>
        <span class="nl-expand-text">Expand</span>
      </button>
      <%# 設定面板（仿 Obsidian）：預設值在 graph.js 的 defaults()，這裡只定範圍 %>
      <div class="nl-panel" data-graph-panel hidden>
        <details open>
          <summary>Filters</summary>
          <label class="nl-row"><span>Tags</span><input type="checkbox" data-set="tags"<%= tagsChecked ? ' checked' : '' %>></label>
          <label class="nl-row"><span>Unwritten</span><input type="checkbox" data-set="ghosts"></label>
          <label class="nl-row"><span>Orphans</span><input type="checkbox" data-set="orphans"></label>
        </details>
        <details>
          <summary>Display</summary>
          <label class="nl-row"><span>Node size</span><input type="range" min="0.5" max="2" step="0.05" data-set="size"></label>
          <label class="nl-row"><span>Link width</span><input type="range" min="0.5" max="3" step="0.1" data-set="width"></label>
          <label class="nl-row"><span>Labels</span><input type="range" min="0" max="1" step="0.05" data-set="labels"></label>
        </details>
        <details open>
          <summary>Forces</summary>
          <label class="nl-row"><span>Center</span><input type="range" min="0" max="1" step="0.02" data-set="center"></label>
          <label class="nl-row"><span>Repel</span><input type="range" min="0" max="20" step="0.5" data-set="repel"></label>
          <label class="nl-row"><span>Link force</span><input type="range" min="0" max="1" step="0.02" data-set="link"></label>
          <label class="nl-row"><span>Link distance</span><input type="range" min="30" max="250" step="5" data-set="distance"></label>
        </details>
        <button type="button" class="nl-reset" data-graph-reset>Reset to defaults</button>
      </div>
    </div>
    <p class="netlist-info" data-graph-info aria-live="polite"
       data-hint="Drag to pan · ⌘/Ctrl + scroll to zoom · click a node to open"
       data-hint-touch="Tap a node to preview · Expand to explore"
       data-hint-full="Drag to pan · scroll to zoom · click a node to open"
       data-hint-full-touch="Drag to pan · pinch to zoom · tap a node">Drag to pan · ⌘/Ctrl + scroll to zoom · click a node to open</p>
    <div class="netlist-card" data-graph-card hidden>
      <div class="nl-card-main">
        <p class="nl-card-meta" data-card-meta></p>
        <p class="nl-card-title" data-card-title></p>
      </div>
      <a class="nl-card-open" data-card-open href="#">Open <span aria-hidden="true">→</span></a>
      <button type="button" class="nl-card-close" data-card-close aria-label="<%= __('graph.deselect') %>">
        <svg class="nl-i" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg>
      </button>
      <div class="nl-card-nb" data-card-nb aria-label="<%= __('graph.neighbors') %>"></div>
    </div>
  </div>
  <script type="application/json"><%- graph.json %></script>
</figure>
