<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<%
  var isHome = is_home() || page.layout === 'index';
  var titleText = page.title && !isHome ? page.title + ' — ' + (theme.profile.name || config.author) : config.title;
  if (isHome) titleText = localize(theme.home && theme.home.title) || config.title;
  if (is_archive()) titleText = 'Archive — ' + config.title;
  if (is_tag()) titleText = '#' + page.tag + ' — ' + config.title;
  if (is_category()) titleText = page.category + ' — ' + config.title;
  var desc = page.summary || page.description || config.description;
%>
<title><%= titleText %></title>
<% if (page.noindex) { %><meta name="robots" content="noindex"><% } %>
<%- open_graph({ title: titleText, description: desc }) %>
<% if (isHome) {
  // 首頁的結構化資料：讓搜尋引擎把中英文名字、學校和這個網站連在一起
  var prof = theme.profile;
  var person = {
    '@type': 'Person',
    '@id': config.url + '/#person',
    name: prof.name_zh || prof.name,
    alternateName: prof.name_zh ? prof.name : undefined,
    url: config.url + '/',
    email: prof.email ? 'mailto:' + prof.email : undefined,
    jobTitle: localize(prof.role) || undefined,
    affiliation: prof.affiliation ? { '@type': 'CollegeOrUniversity', name: localize(prof.affiliation) } : undefined
  };
  var ld = { '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebSite', name: titleText, url: full_url_for(page.path), inLanguage: lang_of(page), author: { '@id': person['@id'] } },
    person
  ] };
%><script type="application/ld+json"><%- JSON.stringify(ld).replace(/</g, '\\u003c') %></script>
<% } %>
<%
  var schemes = scheme_list();
  var schemeBg = {};
  schemes.forEach(function (s) { schemeBg[s] = scheme_info(s).bg; });
%>
<meta name="theme-color" content="<%= schemeBg[schemes[0]][0] %>" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="<%= schemeBg[schemes[0]][1] %>" media="(prefers-color-scheme: dark)">
<link rel="icon" href="<%- url_for('/favicon.svg') %>" type="image/svg+xml">
<% page_versions(page).forEach(function (v) { %><link rel="alternate" hreflang="<%= v.lang %>" href="<%- full_url_for(v.path) %>">
<% }) %>
<script>
  (function () {
    var root = document.documentElement;
    root.classList.add('js');
    try {
      var t = localStorage.getItem('tapeout-theme');
      if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t);
    } catch (e) {}
    // 配色：訪客在右上角色塊選的配色記在 localStorage；main.js 也透過這個函式切換
    var schemeBg = <%- JSON.stringify(schemeBg) %>;
    window.tapeoutScheme = function (name) {
      if (!schemeBg[name]) return false;
      root.setAttribute('data-scheme', name);
      var metas = document.querySelectorAll('meta[name="theme-color"]');
      if (metas.length === 2) { metas[0].content = schemeBg[name][0]; metas[1].content = schemeBg[name][1]; }
      return true;
    };
    try { window.tapeoutScheme(localStorage.getItem('tapeout-scheme')); } catch (e) {}
  })();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="<%- theme.fonts.google %>">
<%- css('css/style') %>
<% if (page.layout === 'dit-compare' || page.layout === 'dit-tower') { %><%- css('css/dit-compare') %><% } %>
<% if (page.layout === 'dit-tower') { %><%- css('css/dit-tower') %><% } %>
<% if (page.layout === 'kroquant') { %><%- css('css/kroquant') %><% } %>
<% if (page.layout === 'svdquant') { %><%- css('css/svdquant') %><% } %>
<% if (page.content && page.content.indexOf('class="katex') > -1) { %><%- css('katex/katex.min') %><% } %>
<% var ga = theme.analytics && theme.analytics.google; if (ga) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= ga %>"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('js', new Date());
  gtag('config', '<%= ga %>');
</script>
<% } %>
