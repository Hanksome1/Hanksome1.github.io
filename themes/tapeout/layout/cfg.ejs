          <li><button type="button" data-stop="cond"><span>01</span>Condition<i></i></button></li>
          <li><button type="button" data-stop="classifier"><span>02</span>Classifier<i></i></button></li>
          <li><button type="button" data-stop="dropout"><span>03</span>Dropout<i></i></button></li>
