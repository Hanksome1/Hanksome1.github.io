<%
  // /tapeout/：首頁的試作版本。hero 換成一段跟著捲動演出的 APR 流程（js/tapeout.js），下面接首頁的 §01–§04
  // 一開始看到整片晶圓，往下捲鑽進正中間那顆 die；晶片永遠整顆看得到，裝在 .to-frame 這一格裡，左邊一欄放名字、個人資料和終端機
  var p = theme.profile;
  var intro = theme.tapeout_intro || {};
  var stages = [
    { key: 'floorplan', name: 'Floorplan' },
    { key: 'placement', name: 'Placement' },
    { key: 'cts', name: 'CTS' },
    { key: 'routing', name: 'Routing' },
    { key: 'tapeout', name: 'Tapeout' }
  ].filter(function (s) { return s.key !== 'cts' || intro.cts !== false; });
  var whoami = (intro.whoami || []).map(function (l) { return localize(l); });
  var highlights = (intro.highlights || []).map(function (l) { return localize(l); });
  var advisor = localize(intro.advisor);
  var social = theme.social || [];
  var email = social.filter(function (s) { return /^mailto:/.test(s.url); })[0];
  var cv = social.filter(function (s) { return s.label === 'CV'; })[0];
  var specs = [
    { k: 'Role', v: localize(p.role) },
    { k: 'School', v: localize(p.affiliation) },
    { k: 'Advisor', v: advisor },
    { k: 'Focus', v: localize(p.focus) }
  ].filter(function (s) { return s.v; });
%>
<div class="to-root" data-tapeout>
  <script type="application/json"><%- JSON.stringify({
    seed: 'tapeout',
    stages: stages.map(function (s) { return s.key; }),
    names: stages.reduce(function (o, s) { o[s.key] = s.name; return o; }, {})
  }) %></script>
  <section class="to-track" data-section="TAPEOUT">
    <div class="to-stage">
      <div class="to-canvas">
        <svg class="to-chip" data-to-chip viewBox="0 0 1000 1000" role="img" aria-label="A chip being placed and routed, then packaged"></svg>
      </div>
      <div class="to-frame" aria-hidden="true"></div>
      <p class="to-hint" aria-hidden="true">Scroll to place &amp; route <span>↓</span></p>

      <p class="to-status" data-state="idle"><i class="to-status-dot" aria-hidden="true"></i><span class="to-status-n" data-status-n>00/<%= pad(stages.length) %></span><span class="to-status-name" data-status-name>Ready</span></p>
      <div class="to-readout">
        <dl class="to-metrics">
          <div><dt>Util</dt><dd data-metric="util">—</dd></div>
          <div><dt>Wirelength</dt><dd data-metric="wire">—</dd></div>
          <div><dt>WNS</dt><dd data-metric="wns">—</dd></div>
          <div><dt>DRC</dt><dd data-metric="drc">—</dd></div>
        </dl>
        <ul class="to-layers" aria-hidden="true">
          <% [1, 2, 3, 4].forEach(function (n) { %><li data-layer="<%= n %>"><i></i>M<%= n %></li><% }) %>
        </ul>
      </div>

      <div class="to-id">
        <p class="to-id-k">HW-26 · Designer</p>
        <h1 class="to-id-name"><%= p.name %><% if (p.name_zh) { %><span class="to-id-zh"><%= p.name_zh %></span><% } %></h1>
        <p class="to-id-tag"><%- emphasize(localize(p.tagline)) %></p>
        <dl class="to-id-spec">
          <% specs.forEach(function (s) { %><div><dt><%= s.k %></dt><dd><%= s.v %></dd></div><% }) %>
        </dl>
        <% if (highlights.length) { %><ul class="to-id-hl"><% highlights.forEach(function (h) { %><li><%= h %></li><% }) %></ul><% } %>
        <p class="to-id-links">
          <% if (email) { %><a href="<%= email.url %>">Email</a><% } %>
          <% if (cv) { %><a href="<%- url_for(cv.url) %>">CV</a><% } %>
          <a href="#sec-projects">Projects <span aria-hidden="true">↓</span></a>
        </p>
      </div>

      <div class="to-term">
        <p class="to-term-bar" aria-hidden="true"><i></i><i></i><i></i><span>hank@nthu: ~/hw26</span></p>
        <div class="to-term-body">
          <p class="to-line" aria-hidden="true"><span class="to-prompt">$</span> whoami</p>
          <p class="to-line to-whoami"><%= p.name %><% if (p.name_zh) { %> <span><%= p.name_zh %></span><% } %><% if (whoami[0]) { %> <span class="to-out">· <%= whoami[0] %></span><% } %></p>
          <% whoami.slice(1).forEach(function (l) { %><p class="to-line to-out"><%= l %></p><% }) %>
          <pre class="to-console" aria-hidden="true"></pre>
        </div>
      </div>
      <a class="to-skip" href="#sec-projects">Skip intro <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <%- partial('_partial/home-sections', { anchors: true }) %>
  <svg class="to-bus" data-to-bus aria-hidden="true"></svg>
</div>
