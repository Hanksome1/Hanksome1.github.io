<%- partial('_partial/progress') %>
<% var isNote = post_kind(page) === 'note'; %>
<article class="article<% if (isNote) { %> article-note<% } %>" data-section="<%= isNote ? 'NOTE' : 'ARTICLE' %>">
  <%- partial('_partial/article-head') %>
  <% if (page.cover) { %>
    <div class="wrap"><img class="article-cover" src="<%- url_for(page.cover) %>" alt=""></div>
  <% } %>
  <%- partial('_partial/article-body') %>
</article>
