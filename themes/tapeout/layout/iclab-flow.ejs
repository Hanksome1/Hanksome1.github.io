    <div class="ic-cols">
      <div>
        <h3>這頁連到的筆記</h3>
        <ul>
          <li>觀念：<a href="<%- notes.intro.href %>"><%= notes.intro.title %></a></li>
          <li>Verilog：<a href="<%- notes.datatype.href %>">資料型態</a>、<a href="<%- notes.operators.href %>">運算子</a>、<a href="<%- notes.assign.href %>">賦值</a>、<a href="<%- notes.timing.href %>">時序控制</a>、<a href="<%- notes.func.href %>">function 與 task</a>、<a href="<%- notes.fsm.href %>">FSM</a>、<a href="<%- notes.guide.href %>">RTL guidelines</a></li>
