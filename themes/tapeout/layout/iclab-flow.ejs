<%
  // ICLAB 設計流程的捲動導覽（js/iclab-flow.js）：黑底，一拍一句大標，畫面在正中間換。
  // 每一拍寫成下面的 <article data-beat>，沒有 JS 時就是依序排好的內容；data-w 是這一拍佔多少捲動距離，data-ch 是章節。
  // NOTES 是筆記入口：[網址, 短標題, 小標]，完整標題直接取自筆記。
  var NOTES = {
    hub:       ['/notes/iclab/', '筆記總覽'],
    intro:     ['/notes/iclab-intro/', '數位 IC 的設計流程'],
    datatype:  ['/notes/iclab-verilog-datatype/', '資料型態與參數'],
    operators: ['/notes/iclab-verilog-operators/', '運算子'],
    assign:    ['/notes/iclab-verilog-assignment/', '賦值與 latch'],
    timing:    ['/notes/iclab-verilog-timing-control/', '時序控制 @ wait #'],
    func:      ['/notes/iclab-verilog-function-task/', 'function 與 task'],
    guide:     ['/notes/iclab-rtl-guideline/', 'RTL coding guidelines'],
    fsm:       ['/notes/iclab-fsm/', 'FSM 的寫法'],
    hw4:       ['/notes/iclab-hw4-qrcode/', 'QR code 解碼器', 'HW4'],
    lab05:     ['/notes/iclab-lab05-cpu/', '三級管線 CPU', 'LAB05'],
    lint:      ['/notes/iclab-spyglass/', '用 SpyGlass 做 lint'],
    tb:        ['/notes/iclab-testbench/', 'Testbench 的寫法'],
    hw1:       ['/notes/iclab-hw1-rop3/', 'ROP3 窮舉驗證', 'HW1'],
    synth:     ['/notes/iclab-synthesis/', '邏輯合成'],
    dc:        ['/notes/iclab-design-compiler/', 'Design Compiler'],
    hw3:       ['/notes/iclab-hw3-enigma/', 'Enigma 合成優化', 'HW2–3'],
    lec:       ['/notes/iclab-lec/', 'Logic equivalence checking'],
    apr:       ['/notes/iclab-apr/', 'APR 流程'],
    fp:        ['/notes/iclab-apr-floorplan/', 'Floorplan'],
    pp:        ['/notes/iclab-apr-powerplan/', 'Power plan'],
    hw5:       ['/notes/iclab-hw5-attention/', 'Attention 加速器', 'HW5'],
    golden:    ['/notes/iclab-3dgs-golden-pattern/', 'Golden pattern 格式', 'FINAL'],
    proj:      ['/projects/3dgs-accelerator/', '3DGS 硬體加速器', 'PROJECT']
  };
  // 筆記的 path 開頭有 /（obsidian.js 的 permalink），專案的沒有，所以比對前兩邊都去掉頭尾的 /
  function trim(s) { return String(s || '').replace(/^\/+|\/+$/g, ''); }
  var byPath = {}, count = 0;
  site.posts.forEach(function (p) {
    byPath[trim(p.path)] = p;
    if (trim(p.path) !== 'notes/iclab' && (p.tags ? p.tags.map(function (t) { return t.name; }) : []).indexOf('ICLAB') > -1) count++;
  });
  var notes = {};
  Object.keys(NOTES).forEach(function (k) {
    var n = NOTES[k], post = byPath[trim(n[0])];
    notes[k] = { href: url_for(n[0]), title: post ? post.title : n[1], short: n[1], kind: n[2] || 'NOTE' };
  });
  function attr(s) { return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;'); }
  function reads(keys) {
    return '<p class="ic-reads"><span>讀筆記</span>' + keys.map(function (k) {
      var n = notes[k];
      return '<a href="' + n.href + '" title="' + attr(n.title) + '">' + attr(n.short) + '</a>';
    }).join('') + '</p>';
  }
%>
<div class="ic" data-ic>
  <header class="ic-hero">
    <p class="ic-kick">ICLAB · EE4292 · 清大電機</p>
    <h1 class="ic-title">11 行 Verilog，<br><span>變成</span>一塊晶片。</h1>
    <p class="ic-lede">一學期的 cell-based design flow，用同一個 8-bit 累加器從頭走到尾。每一站都接到那一站的筆記。</p>
    <p class="ic-skip"><a href="<%- notes.hub.href %>">直接看筆記總覽（<%= count %> 篇）→</a></p>
    <p class="ic-cue" aria-hidden="true">Scroll</p>
  </header>

  <section class="ic-track">
    <div class="ic-stage">
      <div class="ic-viz"><svg class="ic-world" data-world viewBox="-40 -30 680 470" role="img" aria-label="ICLAB 設計流程的動畫：一個 8-bit 累加器從 Verilog、電路、FSM、lint、波形、gate-level netlist、LEC，一路經過 floorplan、power plan、placement、CTS、routing 變成 layout"></svg></div>
      <div class="ic-beats">
      <article class="ic-beat" data-beat="code" data-w="1.3" data-ch="0">
        <header class="ic-head"><p class="ic-kick">01 — RTL · W2–5</p><h2>先寫 <em>11 行</em> Verilog。</h2></header>
        <div class="ic-cap"><p>一個 8-bit 累加器：<code>in_valid</code> 拉高時，把 <code>din</code> 加進 <code>sum</code>。整頁都用這個例子。</p><%- reads(['datatype', 'operators', 'timing', 'func']) %></div>
      </article>
      <article class="ic-beat" data-beat="circuit" data-w="1.3" data-ch="0">
        <header class="ic-head"><p class="ic-kick">01 — RTL · W2–5</p><h2>每一行，<em>都是一塊電路</em>。</h2></header>
        <div class="ic-cap"><p><code>sum + din</code> 是加法器，<code>if (in_valid)</code> 是 MUX，<code>sum &lt;= nxt</code> 是一排 flip-flop。RTL 描述的是架構，不是程式。</p><%- reads(['assign', 'guide']) %></div>
      </article>
      <article class="ic-beat" data-beat="fsm" data-w="1.2" data-ch="0">
        <header class="ic-head"><p class="ic-kick">02 — FSM · W4</p><h2>控制，<em>交給狀態機</em>。</h2></header>
        <div class="ic-cap"><p>State register 是循序，next-state 和 output logic 是組合。大型設計拆成主 FSM 加子 FSM，像 HW4 的 QR code 解碼器。</p><%- reads(['fsm', 'hw4', 'lab05']) %></div>
      </article>
      <article class="ic-beat" data-beat="lint" data-w="1.1" data-ch="1">
        <header class="ic-head"><p class="ic-kick">03 — Lint · W1</p><h2>模擬之前，<em>先 lint</em>。</h2></header>
        <div class="ic-cap"><p>不用 testbench，直接靜態檢查 RTL：會合成出 latch 的寫法、位寬不一致、multiple drivers。ICLAB 的作業都要先過 SpyGlass。</p><%- reads(['lint', 'guide']) %></div>
      </article>
      <article class="ic-beat" data-beat="sim" data-w="1.3" data-ch="1">
        <header class="ic-head"><p class="ic-kick">04 — Simulation · W3</p><h2>在 <em>negedge</em> 餵 pattern。</h2></header>
        <div class="ic-cap"><p>DUT 在 posedge 取樣，testbench 在 negedge 改輸入、比對輸出，避開 race condition。正確答案用另一種方法算，先存成 golden file。</p><%- reads(['tb', 'hw1', 'golden']) %></div>
      </article>
      <article class="ic-beat" data-beat="synth" data-w="1.3" data-ch="2">
        <header class="ic-head"><p class="ic-kick">05 — Synthesis · W6–8</p><h2>合成，換成 <em>standard cell</em>。</h2></header>
        <div class="ic-cap"><p>Design Compiler 讀進 RTL、constraint 和 cell library，組出 gate-level netlist：每個 bit 一個 full adder、一個 MUX、一個 flip-flop。</p><%- reads(['synth', 'dc', 'hw3']) %></div>
      </article>
      <article class="ic-beat" data-beat="lec" data-w="1.2" data-ch="2">
        <header class="ic-head"><p class="ic-kick">06 — LEC · W9–10</p><h2>證明它<em>沒有被改壞</em>。</h2></header>
        <div class="ic-cap"><p>模擬只驗得到跑過的 pattern。LEC 把兩邊的 key point 一一對應，再證明每個 logic cone 在所有輸入下都等價：acc 有 16 個 compared point。</p><%- reads(['lec']) %></div>
      </article>
      <article class="ic-beat" data-beat="floorplan" data-w="0.75" data-ch="3">
        <header class="ic-head"><p class="ic-kick">07 — APR · W11</p><h2>畫出 core 的<em>邊界</em>。</h2></header>
        <div class="ic-cap"><p>APR 讀進 netlist、.lib、.lef、.sdc，先 floorplan：core 多大、長寬比多少、I/O 放在哪一邊。</p><%- reads(['apr', 'fp']) %></div>
      </article>
      <article class="ic-beat" data-beat="power" data-w="0.95" data-ch="3">
        <header class="ic-head"><p class="ic-kick">07 — APR · W12</p><h2>接上<em>三層電源</em>。</h2></header>
        <div class="ic-cap"><p>電從 ring（大水管）經過 stripe（中水管），再由 Metal 1 的 rail（小水管）送進每一排 cell。橘色是 VDD，藍色是 VSS。</p><%- reads(['pp', 'apr']) %></div>
      </article>
      <article class="ic-beat" data-beat="place" data-w="1.2" data-ch="3">
        <header class="ic-head"><p class="ic-kick">07 — APR · W12</p><h2>把 cell <em>排進 row</em>。</h2></header>
        <div class="ic-cap"><p>同一個 library 的 cell 一樣高，才能整齊排在 row 上，共用上下兩條 rail。橘色的是 flip-flop。</p><%- reads(['apr']) %></div>
      </article>
      <article class="ic-beat" data-beat="cts" data-w="0.95" data-ch="3">
        <header class="ic-head"><p class="ic-kick">07 — APR · W12–13</p><h2>長出 <em>clock tree</em>。</h2></header>
        <div class="ic-cap"><p>合成時 clock 是理想的；CTS 才把它接到每個 flip-flop，中間插 buffer 壓低 skew。這一步之後最要注意 hold。</p><%- reads(['apr', 'dc']) %></div>
      </article>
      <article class="ic-beat" data-beat="route" data-w="1.3" data-ch="3">
        <header class="ic-head"><p class="ic-kick">07 — APR · W13</p><h2>最後，<em>把線接起來</em>。</h2></header>
        <div class="ic-cap"><p>奇數層水平、偶數層垂直，換層打 via。繞完才有真的 R、C，再過 DRC、LVS、STA 和 post-layout 模擬，才算 sign-off。</p><%- reads(['apr', 'lec', 'intro']) %></div>
      </article>
      <article class="ic-beat" data-beat="labs" data-w="1.3" data-ch="4">
        <header class="ic-head"><p class="ic-kick">08 — Labs · W14–17</p><h2>每份作業，<em>練其中一站</em>。</h2></header>
        <div class="ic-cap"><p>HW1 練 testbench，HW3 練合成，HW4 練 FSM，HW5 練 datapath 共用，Lab05 把 CPU 接上 SRAM。</p><%- reads(['hw1', 'hw3', 'hw4', 'hw5', 'lab05']) %></div>
      </article>
      <article class="ic-beat ic-final" data-beat="final" data-w="1.1" data-ch="4">
        <header class="ic-head"><p class="ic-kick">ICLAB · EE4292</p><h2>這就是 ICLAB 的<em>一學期</em>。</h2></header>
        <div class="ic-cap">
          <p>期末的 3DGS 硬體加速器把整條 flow 走完一次：367.8 FPS、post-layout 功耗 2.63 mW，25 組裡第一。</p>
          <p class="ic-cta"><a class="ic-btn is-pri" href="<%- notes.hub.href %>">看全部 <%= count %> 篇筆記 →</a><a class="ic-btn" href="<%- notes.proj.href %>">期末專題</a></p>
        </div>
      </article>
      </div>
      <nav class="ic-rail" data-rail data-names="RTL|Verify|Synthesis|APR|Labs" aria-label="章節"></nav>
      <button type="button" class="ic-play" data-play aria-label="自動播放"><span class="ic-play-icon" aria-hidden="true"></span><span data-play-label>Auto-play</span></button>
    </div>
  </section>

  <section class="ic-outro wrap">
    <p class="kicker">§ Summary</p>
    <h2>三件事</h2>
    <ol class="ic-take">
      <li><b>每一站都在換表示法。</b>RTL、netlist、layout 是同一個電路的三種寫法，每換一次就用 LEC 或 LVS 確認功能沒變，模擬只是其中一種驗證。</li>
      <li><b>工具會化簡，結構要自己決定。</b>合成把邏輯壓得很好，但 pipeline 切在哪、FSM 怎麼拆、datapath 要不要共用，都要在 RTL 想清楚。HW3 裡直覺很貴的 shift 反而比 offset 好。</li>
      <li><b>越後面的數字越真。</b>Wire load model、APR 初估、RC extraction 一路變準，timing 也一路變差，所以每一站都要留 margin，floorplan 時就先試擺、看 congestion。</li>
    </ol>

    <div class="table-wrap">
      <table class="ic-table">
        <caption>課程進度（取自筆記總覽）</caption>
        <thead><tr><th>週</th><th>課程主題</th><th>Lab</th><th>這頁的哪一站</th></tr></thead>
        <tbody>
          <tr><td>1</td><td>課程介紹、cell-based design flow</td><td>工作站環境、SpyGlass</td><td>03 Lint</td></tr>
          <tr><td>2</td><td>Verilog</td><td>Verilog simulator</td><td>01 RTL</td></tr>
          <tr><td>3</td><td>Testbench、function 與 task</td><td>Testbench 的 debug 與撰寫</td><td>04 Sim</td></tr>
          <tr><td>4</td><td>合成、FSM</td><td>Verdi、FSM 練習</td><td>02 FSM</td></tr>
          <tr><td>5</td><td>RTL coding guidelines</td><td>RTL 模擬與除錯</td><td>01 RTL</td></tr>
          <tr><td>6</td><td>Synthesis (I)：Design Compiler</td><td>Coding for synthesis (I)</td><td>05 Synth</td></tr>
          <tr><td>7</td><td>–</td><td>Line-based 影像處理</td><td>02 FSM</td></tr>
          <tr><td>8</td><td>Synthesis (II)：為合成做最佳化</td><td>Coding for synthesis (II)</td><td>05 Synth</td></tr>
          <tr><td>9–10</td><td>Logic equivalence checking</td><td>LEC、LEC 實務</td><td>06 LEC</td></tr>
          <tr><td>11</td><td>APR (I)：physical design flow</td><td>Innovus：floorplan</td><td>07 APR</td></tr>
          <tr><td>12</td><td>APR (II)：Cadence Innovus</td><td>Power plan、placement、CTS、routing</td><td>07 APR</td></tr>
          <tr><td>13</td><td>Design examples</td><td>CTS、routing、驗證、power analysis</td><td>07 APR</td></tr>
          <tr><td>14–17</td><td>期末專題</td><td>專題諮詢與報告</td><td>08 Labs</td></tr>
        </tbody>
      </table>
    </div>

    <div class="ic-cols">
      <div>
        <h3>這頁連到的筆記</h3>
        <ul>
          <li>觀念：<a href="<%- notes.intro.href %>"><%= notes.intro.title %></a></li>
          <li>Verilog：<a href="<%- notes.datatype.href %>">資料型態</a>、<a href="<%- notes.operators.href %>">運算子</a>、<a href="<%- notes.assign.href %>">賦值</a>、<a href="<%- notes.timing.href %>">時序控制</a>、<a href="<%- notes.func.href %>">function 與 task</a>、<a href="<%- notes.fsm.href %>">FSM</a>、<a href="<%- notes.guide.href %>">RTL guidelines</a></li>
          <li>驗證：<a href="<%- notes.tb.href %>">Testbench</a>、<a href="<%- notes.lint.href %>">SpyGlass</a>、<a href="<%- notes.lec.href %>">LEC</a></li>
          <li>合成：<a href="<%- notes.synth.href %>">邏輯合成</a>、<a href="<%- notes.dc.href %>">Design Compiler</a></li>
          <li>APR：<a href="<%- notes.apr.href %>">APR 流程</a>、<a href="<%- notes.fp.href %>">Floorplan</a>、<a href="<%- notes.pp.href %>">Power plan</a></li>
          <li>作業：<a href="<%- notes.hw1.href %>">HW1</a>、<a href="<%- notes.hw3.href %>">HW2–3</a>、<a href="<%- notes.hw4.href %>">HW4</a>、<a href="<%- notes.hw5.href %>">HW5</a>、<a href="<%- notes.lab05.href %>">Lab05</a>；期末：<a href="<%- notes.proj.href %>">3DGS 加速器</a>、<a href="<%- notes.golden.href %>">golden pattern</a></li>
        </ul>
      </div>
      <div>
        <h3>資料來源與畫面怎麼來的</h3>
        <ul>
          <li>流程、指令和所有數字都取自上面的筆記：clock gating 的面積與功耗是 Lab06，Enigma 的 PI 是 HW3，乘法器的比對時間是 Lab10，3DGS 的規格取自專案頁。</li>
          <li>8-bit 累加器 acc 是為這頁寫的小例子。它的 netlist、波形、key point 數照 RTL 算得出來，但 netlist 只畫到 cell 層級，floorplan 到 routing 的 layout 是固定種子產生的示意圖，不是 Innovus 跑出來的結果。</li>
        </ul>
      </div>
    </div>
  </section>
</div>
